# 値は例。秘密鍵は空欄。npm run db:start が .env.local にローカル専用の値を生成します。
DATABASE_URL=
NEXT_TELEMETRY_DISABLED=1
POC_OWNER_ID=11111111-1111-4111-8111-111111111111
POC_DATA_DIR=.poc-data
AI_PROVIDER=mock
GENERATIONS_ENABLED=true
LIVE_API_ENABLED=false
LIVE_TERMS_REVIEWED=false
LIVE_BUDGET_APPROVED=false
LIVE_CONSENT_VERSION=
LIVE_APPROVAL_ID=
FAL_KEY=
# 公式仕様確認後に設定。未確認のまま実送信しない。
LIVE_MAX_REFERENCE_IMAGES=0
LIVE_MAX_CALLS=0
LIVE_TOTAL_BUDGET_JPY=0
LIVE_MONTHLY_BUDGET_JPY=0
LIVE_MAX_COST_JPY=0
LIVE_USD_JPY=0
LIVE_PRICE_USD=
LIVE_PRICE_CHECKED_AT=
# HTTP送信後の再送はしない。期限を超えると照合待ちへ。
JOB_TIMEOUT_SECONDS=180
